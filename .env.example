# Local, offline-auth test server only. No Minecraft or OpenAI passwords needed.
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=SurvivalBot
MC_VERSION=26.1
CONNECT_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=3000
STATE_INTERVAL_MS=5000
LOG_DIR=logs
# 0 keeps running; set to 15000 for a 15-second post-spawn smoke test.
RUN_DURATION_MS=0
# No OpenAI integration exists yet. Do not add a key for Milestone 1.
# Optional bounded Gemini demo only. Put your own key in ignored .env; never commit it.
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.8-flash
